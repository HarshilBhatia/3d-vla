  "residual_conditions": [
    "e3deg-t1cm"
  ],
  "min_step": 70000,
  "step_interval": 10000,
  "tasks": [
    {
      "task": "bimanual_lift_ball",
      "spawn_camera_group": "G2"
    },
    {
      "task": "bimanual_push_box",
      "spawn_camera_group": "G1"
    },
    {
      "task": "bimanual_handover_item_easy",
      "spawn_camera_group": "G6"
    },
    {
      "task": "bimanual_pick_laptop",
      "spawn_camera_group": "G2"
    },
    {
      "task": "bimanual_pick_plate",
      "spawn_camera_group": "G4"
    },
    {
      "task": "bimanual_straighten_rope",
      "spawn_camera_group": "G3"
    }
  ],
  "runtime": {
    "data": "orbital_peract2_nfs",
    "dataset": "OrbitalPeract2",
    "bimanual": true,
    "data_dir": "/grogu/datasets/hbhatia/peract2_test/peract2_test",
    "headless": true,
