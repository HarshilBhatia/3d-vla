{
  "schema_version": 1,
  "protocol_id": "nowrist4_video_checkpoint_ladder_v01",
  "description": "No-wrist four-task ladder (external cameras only): Video-DeltaM K=5 visual / K=3 proprio checkpoint ladder on the training-style external calibration condition: medium fixed group base plus one materialized 3 degree / 1 cm residual.",
  "calibration_registry": "instructions/eval_calibrations_seen_base_residual_v01.json",
  "output_root": "/grogu/datasets/hbhatia/3dfa_online_eval_20rollouts",
  "base_level": "medium",
  "realization_version": "v01",
  "residual_conditions": [
    "e3deg-t1cm"
  ],
  "min_step": 50000,
  "step_interval": 10000,
  "tasks": [
    {
      "task": "bimanual_handover_item",
      "spawn_camera_group": "G1"
    },
    {
      "task": "bimanual_take_tray_out_of_oven",
      "spawn_camera_group": "G1"
    },
    {
      "task": "bimanual_sweep_to_dustpan",
      "spawn_camera_group": "G4"
    },
    {
      "task": "bimanual_dual_push_buttons",
      "spawn_camera_group": "G3"
    }
  ],
  "runtime": {
    "data": "orbital_peract2_nfs",
    "dataset": "OrbitalPeract2",
    "bimanual": true,
    "data_dir": "/grogu/datasets/hbhatia/peract2_test/peract2_test",
    "headless": true,
    "max_tries": 1,
    "eval_use_depth2cloud": true,
    "num_demos_total": 20,
    "overrides": {
      "scene_sampling": "fps",
      "eval_proprio_history_order": "past_to_current"
    }
  }
}
