 "todos": [
  {
   "id": "1",
   "title": "\u03b4M per layer and per sample",
   "status": "done",
   "models": "exp 3, VideoPooled, warm random history",
   "question": "\u03b4M is re-predicted before every SA layer. Does it vary with depth, across scenes, with miscalibration?",
   "result": "Per layer it is a fixed rotation: \u2016\u0394M\u2212I\u2016 exp 3 200k = 0.70 / 2.66 / 0.29 / 0.28 (CA / SA1 / SA2 / SA3). SA1 is pinned at the predictor's clamp. Across samples \u2264 0.15, cam 0 = cam 1, \u2264 1\u00b0 change under 60/60, 1\u20132 of 120 predictor units alive.",
   "conclusion": "\u03b4M is a learned fixed per-layer transform, not a per-scene or per-camera correction. Re-run at K = 5 after the loader fix: unchanged."
  },
  {
   "id": "2",
   "title": "What 1b's adaLN signal encodes",
   "status": "done",
   "models": "1b",
   "question": "What does the C-token term of 1b's adaLN carry?",
   "result": "Constant at CA/SA0. After SA: shifts modulation by 7\u201338%, varies 16\u201335% across samples, 44\u201371% of that is task. 60/60 moves it by 1\u20135%.",
   "conclusion": "A task and scene cue, not a calibration signal."
  },
  {
   "id": "3",
   "title": "Attention: external vs wrist cameras",
   "status": "done (hypothesis rejected)",
   "models": "exp 3, 1b, A, warm RH+EMA",
   "question": "Do robust models move attention off the miscalibrated external cameras under 60/60?",
   "result": "Every shift is \u2264 2 points; control A shifts as much as anyone. The FPS sampler keeps only 10\u201319% external tokens, so 80\u201395% of SA attention is on wrist tokens even with clean cameras.",
   "conclusion": "No rerouting. The architecture leans on the wrist cameras by construction."
  },
  {
   "id": "4",
   "title": "What exp 3's \u03b4M does to the RoPE kernel",
   "status": "done",
   "models": "exp 3 (weights only)",
   "question": "Does \u03b4M blur, sharpen or shift attention's dependence on 3D distance?",
   "result": "Head RoPE tops out at 1 rad/m (wavelength \u2248 6.3 m). \u03b4M acts like a fixed key-side projection; being orthogonal it cannot reduce a miscalibration's positional change (0.340 for every \u0394M). SA1 roughly doubles the content-free change.",
   "conclusion": "Not a camera correction. The 3D RoPE is very coarse for a ~1 m workspace."
  },
  {
   "id": "5",
   "title": "Linear probes: camera pose and injected miscalibration",
   "status": "done",
   "models": "exp 3, 1b, A, RH+EMA, random init",
   "question": "Do the C-tokens, \u03b4M or the adaLN term know where the camera is, or how wrong its extrinsics are?",
   "result": "Camera group: encoder 0.93\u20130.95, after extractor 0.18\u20130.23 (chance), random init 0.98. \u03b4M and adaLN term: pose \u2264 0.33, miscalibration R\u00b2 = 0.00. Head C-tokens regain weak miscalibration (R\u00b2 \u2264 0.22), most in control A.",
   "conclusion": "Pose comes from frozen SigLIP and is discarded by the trained extractor. Neither mechanism has the information it would need to correct geometry."
  },
  {
   "id": "6",
   "title": "Does the prediction follow the miscalibrated cameras?",
   "status": "done",
   "models": "exp 3, 1b, A",
   "question": "Under 60/60, does the predicted keypose move the way the wrong camera geometry would move it?",
   "result": "Following coefficient \u2264 0.007; \u2265 99.7% of predictions stay nearest the true target. With all 4 cameras shifted together they follow (0.6 at 10/10, 0.4 at 60/60).",
   "conclusion": "Models use geometry when consistent and side with the calibrated wrists and proprio when the external cameras disagree."
  },
  {
