# ── DeltaAI cluster (NCSA, H100 GPUs) ────────────────────────────────────────
export CLUSTER_NAME=deltaai

# SBATCH header overrides (used by scripts/submit)
export CLUSTER_PARTITION=ghx4
export CLUSTER_ACCOUNT=bgkz-dtai-gh
export CLUSTER_TIME=48:00:00
export CLUSTER_EXCLUDE=""

# Repo + environment (same as delta)
export CLUSTER_REPO=/projects/bgkz/hbhatia1/vla/3d-vla
export CLUSTER_CONDA_INIT=/u/hbhatia1/micromamba/etc/profile.d/mamba.sh
export CLUSTER_CONDA_CMD="micromamba activate 3dfa"

# Data paths (same as delta)
export CLUSTER_DATA_ROOT=/work/nvme/bgkz/harshilb
export CLUSTER_LOG_DIR=/work/hdd/bgkz/hbhatia1/train_logs

# Data staging: rsync to /tmp/$SLURM_JOB_ID (fast NVMe local storage)
export CLUSTER_STAGE_METHOD=tmpdir
export CLUSTER_SCRATCH_ROOT=""
