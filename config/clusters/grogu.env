# ── Grogu cluster (CMU Shubham lab nodes) ────────────────────────────────────
export CLUSTER_NAME=grogu

# SBATCH header overrides (used by scripts/submit)
export CLUSTER_PARTITION=shubhamlong
export CLUSTER_ACCOUNT=""
export CLUSTER_TIME=24:00:00
export CLUSTER_EXCLUDE="grogu-0-[14,19,24,29],grogu-1-[6,9,14],grogu-3-25"

# Repo + environment
export CLUSTER_REPO=/home/harshilb/3d_flowmatch_actor
export CLUSTER_CONDA_INIT=~/miniconda3/etc/profile.d/conda.sh
export CLUSTER_CONDA_CMD="conda activate 3dfa"

# Data paths
export CLUSTER_DATA_ROOT=/grogu/user/harshilb/
export CLUSTER_ORB_DATA=/grogu/datasets/hbhatia/
export CLUSTER_LOG_DIR=""                    # relative: train_logs/ inside repo

# Data staging: rsync /grogu → /scratch before training
export CLUSTER_STAGE_METHOD=scratch
export CLUSTER_SCRATCH_ROOT=/scratch/harshilb
