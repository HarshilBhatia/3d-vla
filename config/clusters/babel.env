# ── Babel cluster (CMU, multi-GPU pool) ──────────────────────────────────────
export CLUSTER_NAME=babel

# SBATCH header overrides (used by scripts/submit)
export CLUSTER_PARTITION=general
export CLUSTER_ACCOUNT=""
export CLUSTER_TIME=2-00:00:00
export CLUSTER_EXCLUDE=""
# Babel uses --constraint instead of a partition per GPU type
export CLUSTER_CONSTRAINT="L40S|L40|A100_40GB|A100_80GB|H100|H200"

# Repo + environment
export CLUSTER_REPO=/home/harshilb/3d-vla
export CLUSTER_CONDA_INIT="$(conda info --base 2>/dev/null)/etc/profile.d/conda.sh"
export CLUSTER_CONDA_CMD="conda activate wm"

# Data paths
export CLUSTER_DATA_ROOT=/data/user_data/harshilb
export CLUSTER_LOG_DIR=""   # relative: train_logs/ inside repo

# Data staging: rsync to /tmp/$SLURM_JOB_ID
export CLUSTER_STAGE_METHOD=none
export CLUSTER_SCRATCH_ROOT=""

# Email on job failure/timeout/requeue
export CLUSTER_MAIL_USER=harshilb@andrew.cmu.edu

# Babel-specific env vars (set in load_cluster via CLUSTER_EXTRA_ENV)
export CLUSTER_EXTRA_ENV="
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export TRITON_CACHE_DIR=/data/user_data/harshilb/triton_cache
export HF_HOME=/data/user_data/harshilb/hf_cache
"
