#!/usr/bin/env bash
# Submit a .slurm script to a named cluster.
#
# Usage:
#   bash scripts/submit <cluster> <script.slurm> [extra sbatch args...]
#
# The cluster name maps to config/clusters/<name>.env, which provides
# SBATCH overrides (partition, account, time, exclude).  Any extra args
# are forwarded verbatim to sbatch.
#
# Examples:
#   bash scripts/submit grogu   scripts/train/cotrain_mixed_miscal.slurm
#   bash scripts/submit delta   scripts/train/train_multicam_default.slurm
#   bash scripts/submit deltaai scripts/train/train_multicam_default.slurm --gres=gpu:4
#   bash scripts/submit grogu   scripts/train/debug.slurm --time=02:00:00

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

DRY_RUN=0
if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN=1
    shift
fi

if [[ $# -lt 1 ]]; then
    echo "Usage: bash scripts/submit [--dry-run] [<cluster>] <script.slurm> [extra sbatch args...]"
    echo ""
    echo "  <cluster>   optional; defaults to \$CLUSTER_NAME (currently: ${CLUSTER_NAME:-unset})"
    echo "  --dry-run   run the script directly with bash instead of submitting to sbatch"
    echo ""
    echo "Available clusters:"
    ls "$REPO_ROOT/config/clusters/"*.env 2>/dev/null \
        | xargs -n1 basename | sed 's/\.env/    /'
    exit 1
fi

# If the first arg looks like a known cluster env file, treat it as the cluster name;
# otherwise fall back to $CLUSTER_NAME.
if [[ -f "$REPO_ROOT/config/clusters/${1}.env" ]]; then
    CLUSTER=$1
    shift
else
    CLUSTER="${CLUSTER_NAME:?CLUSTER_NAME is not set — set it in ~/.bashrc or pass a cluster name explicitly}"
fi

SLURM_SCRIPT=$1
shift

ENV_FILE="$REPO_ROOT/config/clusters/${CLUSTER}.env"
if [[ ! -f "$ENV_FILE" ]]; then
    echo "[ERROR] Unknown cluster: '$CLUSTER' (no file at $ENV_FILE)"
    exit 1
fi

if [[ ! -f "$SLURM_SCRIPT" ]]; then
    echo "[ERROR] Script not found: $SLURM_SCRIPT"
    exit 1
fi

source "$ENV_FILE"

# Parse per-script resource args from a '# SLURM: --flag val ...' comment line
SCRIPT_SLURM_ARGS=()
while IFS= read -r line; do
    if [[ "$line" =~ ^#\ SLURM:\ (.*) ]]; then
        read -ra _args <<< "${BASH_REMATCH[1]}"
        SCRIPT_SLURM_ARGS+=("${_args[@]}")
        break
    fi
done < "$SLURM_SCRIPT"

JOB_NAME="$(basename "$SLURM_SCRIPT" .slurm)"
mkdir -p "$REPO_ROOT/logs/${CLUSTER}"

# Build sbatch args: fixed defaults + cluster profile + per-script resources
SBATCH_ARGS=(
    "--job-name=${JOB_NAME}"
    "--output=logs/${CLUSTER}/%j.out"
    "--error=logs/${CLUSTER}/%j.err"
    "--nodes=1"
    "--ntasks-per-node=1"
    "--partition=${CLUSTER_PARTITION}"
    "--time=${CLUSTER_TIME}"
    "${SCRIPT_SLURM_ARGS[@]}"
)
[[ -n "${CLUSTER_ACCOUNT:-}" ]]    && SBATCH_ARGS+=("--account=${CLUSTER_ACCOUNT}")
[[ -n "${CLUSTER_EXCLUDE:-}" ]]    && SBATCH_ARGS+=("--exclude=${CLUSTER_EXCLUDE}")
[[ -n "${CLUSTER_CONSTRAINT:-}" ]] && SBATCH_ARGS+=("--constraint=${CLUSTER_CONSTRAINT}")
[[ -n "${CLUSTER_MAIL_USER:-}" ]]  && SBATCH_ARGS+=("--mail-user=${CLUSTER_MAIL_USER}" "--mail-type=FAIL,TIME_LIMIT,REQUEUE")

echo "[submit] cluster    : $CLUSTER_NAME"
echo "[submit] partition  : $CLUSTER_PARTITION"
echo "[submit] script     : $SLURM_SCRIPT"
[[ -n "${CLUSTER_ACCOUNT:-}" ]] && echo "[submit] account    : $CLUSTER_ACCOUNT"
[[ -n "${CLUSTER_EXCLUDE:-}" ]] && echo "[submit] exclude    : $CLUSTER_EXCLUDE"
[[ $# -gt 0 ]]                  && echo "[submit] extra args : $*"
echo ""

if [[ $DRY_RUN -eq 1 ]]; then
    export REPO_ROOT CLUSTER
    export "${!CLUSTER_@}"
    bash "$SLURM_SCRIPT" "$@"
else
    sbatch "${SBATCH_ARGS[@]}" --export=ALL,REPO_ROOT="$REPO_ROOT",CLUSTER="$CLUSTER" "$@" "$SLURM_SCRIPT"
fi
